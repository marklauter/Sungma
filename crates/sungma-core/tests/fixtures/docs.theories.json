        { "computed": "banned" }
      ]
    },
    "auditor": { "intersection": ["this", { "computed": "viewer" }] },
    "banned": "this"
  },
  "folder": {
    "owner": "this",
    "parent": "this",
    "viewer": {
      "exclusion": [
        {
          "union": [
            "this",
            { "fact_to": { "factset": "parent", "computed": "viewer" } }
          ]
        },
        { "computed": "banned" }
      ]
    },
    "banned": "this"
  },
  "group": {
