#!/bin/sh
# The slow CI checks, before each push: coverage and the dependency audit.
# Needs cargo-llvm-cov and cargo-audit installed. Mutation testing is too
# slow for a push, so it runs in CI only.
set -e
scripts/dynamodb.sh
# The API tests run on DynamoDB as well as in memory only with this set.
export SUNGMA_DYNAMODB_URL="${SUNGMA_DYNAMODB_URL:-http://localhost:8000}"
cargo llvm-cov --workspace --locked --fail-under-lines 95 --summary-only
cargo audit --deny warnings
