{
  "file": {
    "auditor": {
      "rewrite": "this & viewer",
      "constraints": ["identity"]
    },
    "banned": {
      "constraints": ["identity"]
    },
    "editor": {
      "rewrite": "this | owner",
      "constraints": ["group#member", "identity"]
    },
    "owner": {
      "constraints": ["identity"]
    },
    "parent": {
      "constraints": ["folder", "folder#owner", "identity"]
    },
    "viewer": {
      "rewrite": "(this | editor | (parent, viewer)) ! banned",
      "constraints": ["group#member", "identity"]
    }
  }
}
