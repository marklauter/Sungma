{
  "folder": {
    "banned": {
      "constraints": ["identity"]
    },
    "owner": {
      "constraints": ["identity"]
    },
    "parent": {
      "constraints": ["folder"]
    },
    "viewer": {
      "rewrite": "(this | (parent, viewer)) ! banned",
      "constraints": ["group#member", "identity"]
    }
  }
}
